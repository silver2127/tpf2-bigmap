#!/usr/bin/env bash
set -euo pipefail
root=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
[ $# -gt 0 ] || { echo 'Use this launcher followed by %command% in Steam launch options.' >&2; exit 2; }
# Multiplayer installed later: use its loader so both products keep working.
if [ -x "$root/tpf2mp-launch" ]; then exec "$root/tpf2mp-launch" "$@"; fi
case "$root" in *[[:space:]:]*) echo 'Unsupported whitespace/colon in loader path.' >&2; exit 1;; esac
export TPF2MP_DATADIR="$root/data"
export LD_PRELOAD="$root/tpf2_pluginhost.so${LD_PRELOAD:+:$LD_PRELOAD}"
exec "$@"
